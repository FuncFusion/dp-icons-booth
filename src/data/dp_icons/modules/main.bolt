append function_tag minecraft:load:
  values: 
    - "dp_icons:load"

function dp_icons:tick:
  pass

function dp_icons:load:
  say hello world
  # execute as @a at @s if block ~ ~ ~ air run scoreboard players set @s dp_icons.var 1
  execute as @a at @s if block ~ ~ ~ air run scoreboard players set @s dp_icons.var 1
  as @a at @s if block ~ ~ ~ air run scoreboard players set @s dp_icons.var 1

  pack_mcmeta = Node("pack.mcmeta", "txt")
  data_dir = Node("data", "dir")
  namespace = Node("namespace", "dir", data_dir)
  function = Node("function", "dir", namespace)
