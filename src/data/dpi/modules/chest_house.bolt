import bolt_expressions as expr
from dpi:config import var

prefix = "#dpi.chest_house."
p = prefix

append function dpi:load:
  chest_open = var[p + "state"]
  someone_inside = var[p + "someone_inside"]
  self_inside = var[p + "self_inside"]

function dpi:chest_house/on_player_enter:
  tag @s add dpi.chest_house.bounding_box
  function dpi:chest_house/enter_bounding_box

function dpi:chest_house/on_player_exit:
  tag @s remove dpi.chest_house.bounding_box
  function dpi:chest_house/exit_bounding_box

append function dpi:tick/booth_player:
  x = 126
  y = 99
  z = -128

  x2 = 102
  y2 = 124
  z2 = -105

  dx = x2 - x
  dy = y2 - y
  dz = z2 - z

  in_bounding_box = 0

  store success score f"{p}someone_inside" dpi.var if entity @p[tag=dpi.chest_house.bounding_box]
  store success score f"{p}self_inside" dpi.var if entity @s[tag=dpi.chest_house.bounding_box]
  
  if self_inside:
    function dpi:chest_house/in_bounding_box
  elif not someone_inside and not self_inside:
    function dpi:chest_house/outside_bounding_box

function dpi:chest_house/in_bounding_box:
  unless entity @s[tag=dpi.chest_house.bounding_box] run function dpi:event/enter_bounding_box

function dpi:chest_house/outside_bounding_box:
  if entity @s[tag=dpi.chest_house.bounding_box] run function dpi:event/exit_bounding_box

function dpi:chest_house/open:
  if chest_open:
    return 0
  chest_open = 1
  execute as @e[type=minecraft:item_display,tag=dpi.aj.chest_house.root,limit=1] at @s:
    function dpi:aj/chest_house/animations/chest_open/play
    function dpi:lev_icons/fly_out
    playsound minecraft:ui.toast.in block @a[tag=summit.in_booth.dpi] ~ ~10 ~ 3.0 0.69
    playsound minecraft:block.chest.open block @a[tag=summit.in_booth.dpi] ~ ~10 ~ 3.0 0.80

function dpi:chest_house/close:
  if not chest_open:
    return 0
  chest_open = 0
  execute as @e[type=minecraft:item_display,tag=dpi.aj.chest_house.root,limit=1] at @s:
    function dpi:aj/chest_house/animations/chest_close/play
    function dpi:lev_icons/fly_in
    playsound minecraft:ui.toast.out block @a[tag=summit.in_booth.dpi] ~ ~10 ~ 3.0 0.69
    playsound minecraft:block.chest.close block @a[tag=summit.in_booth.dpi] ~ ~10 ~ 3.0 0.80

function dpi:event/enter_bounding_box:
  tag @s add dpi.chest_house.bounding_box
  schedule clear dpi:chest_house/close
  schedule function dpi:chest_house/open 15 replace

  execute run function dpi:chest_house/create_lid_collision:
    fill 107 104 -110 120 117 -106 barrier
    fill 114 118 -109 113 118 -112 barrier

function dpi:event/exit_bounding_box:
  tag @s remove dpi.chest_house.bounding_box
  tag @s remove dpi.pending
  tag @s remove dpi.has_book
  schedule clear dpi:chest_house/open
  schedule function dpi:chest_house/close 12 replace

  execute run function dpi:chest_house/remove_lid_collision:
    fill 107 104 -110 120 117 -106 air
    fill 114 118 -109 113 118 -112 air

function dpi:exit_portal/on_player_exit:
  tag @s remove dpi.pending
  tag @s remove dpi.has_book
