import bolt_expressions as expr
from dpi:config import var

prefix = "#dpi.chest_house."
p = prefix

append function dpi:load:
  last_used = expr.Scoreboard.objective("dpi.chest_house.open.last_used", "dummy")
  # timer = expr.Scoreboard.objective("dpi.chest_house.open.timer", "dummy")
  timer = var[p + "timer"]
  debounce_interval = var[p + "debounce_interval"]
  chest_open = var[p + "state"]

append function dpi:tick/player:
  title @s actionbar {score:{name:"#dpi.chest_house.timer",objective:"dpi.var"}}
  
  x = 126
  y = 99
  z = -128

  x2 = 102
  y2 = 124
  z2 = -105

  dx = x2 - x
  dy = y2 - y
  dz = z2 - z

  if entity @s[x=x, y=y, z=z, dx=dx, dy=dy, dz=dz] run function dpi:chest_house/in_bounding_box
  unless entity @s[x=x, y=y, z=z, dx=dx, dy=dy, dz=dz] run function dpi:chest_house/outside_bounding_box

function dpi:chest_house/open:
  chest_open = 1
  execute as @n[type=minecraft:item_display,tag=dpi.aj.chest_house.root]:
    function dpi:aj/chest_house/animations/chest_open/play
    function dpi:lev_icons/fly_out

function dpi:chest_house/close:
  chest_open = 0
  execute as @n[type=minecraft:item_display,tag=dpi.aj.chest_house.root]:
    function dpi:aj/chest_house/animations/chest_close/play
    function dpi:lev_icons/fly_in

function dpi:chest_house/in_bounding_box:
  if timer:
    timer -= 1

  unless entity @s[tag=dpi.chest_house.bounding_box] run function dpi:event/enter_bounding_box

  if timer == 0 and not chest_open:
    function dpi:chest_house/open

function dpi:chest_house/outside_bounding_box:
  if timer:
    timer -= 1

  if entity @s[tag=dpi.chest_house.bounding_box] run function dpi:event/exit_bounding_box

  if timer == 0 and chest_open:
    function dpi:chest_house/close

function dpi:event/enter_bounding_box:
  timer = 15
  tag @s add dpi.chest_house.bounding_box

  execute run function dpi:chest_house/create_lid_collision:
    fill 107 104 -110 120 117 -106 barrier
    fill 114 118 -109 113 118 -112 barrier

function dpi:event/exit_bounding_box:
  timer = 12
  tag @s remove dpi.chest_house.bounding_box

  execute run function dpi:chest_house/remove_lid_collision:
    fill 107 104 -110 120 117 -106 air
    fill 114 118 -109 113 118 -112 air
