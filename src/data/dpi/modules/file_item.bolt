import bolt_expressions as expr
from dpi:config import var, storage, print_nbt, jump, get_icon
import os

function dpi:file_item/give:
  # change to other type of notification
  execute if items entity @s container.* writable_book[custom_data~{dpi:{file_item:1b}}] run return 0
  execute if items entity @s enderchest.* writable_book[custom_data~{dpi:{file_item:1b}}] run return 0
  loot give @s loot {pools:[{rolls:1,entries:[{type:"minecraft:item",name:"minecraft:writable_book",functions:[{function:"minecraft:set_components",components:{"minecraft:consumable":{consume_seconds:999999999},"minecraft:custom_data":"{summit:{persist:{},droppable:{callback:1b}},dpi:{file_item:1b}}","minecraft:item_name":"File","minecraft:item_model":"dpi:file_item"}},{function:"minecraft:set_lore",lore:[[{atlas:"items",sprite:"dpi:item/logos/deta_rack",color:"white",italic:0b}," ",{text:"DATAPACK",font:"dpi:tooltip"}," ",{text:"ICONS",font:"dpi:tooltip"}],[""],[{text:"Right click to open",color:"dark_gray"}],[{text:"Write the desired filename",color:"dark_gray"}],[{keybind:"key.drop",color:"dark_gray"},{text:" to apply!",color:"dark_gray"}]],mode:"replace_all"}]}]}]}

advancement dpi:first_file_item_recieve {"criteria":{"impossible":{"trigger":"minecraft:impossible"}}}

append function_tag summit.items:droppable/callback:
  values:
    - "dpi:file_item/dropped"

function dpi:file_item/dropped:
  if items entity @s contents writable_book[custom_data~{dpi:{file_item:true}}]
    function dpi:string_input/submit

function dpi:string_input/submit:
  on origin function dpi:file_item/give
  sio_output = storage.string_input.output
  character_limit = 48
  sio_length = var["#dpi.sio_length"]

  executor = expr.Data.entity("@s")
  sio_output = executor.Item.components."minecraft:writable_book_content".pages[0].raw
  sio_length = len(sio_output)

  if sio_length < character_limit:
    on origin function dpi:file_item/submit_name
  else:
    on origin run title @s actionbar [
      {
        text:f"String can't be longer than {character_limit} characters!",
        color:"red"
      }
    ]

  kill @s

function dpi:file_item/submit_name:
  storage.parse_input.input.raw_name = storage.string_input.output
  storage.split_string.input = storage.string_input.output
  function dpi:parse_input/init

  file_name = storage.parse_input.output.file_name
  file_type = storage.parse_input.output.type

  storage.modify_icon.input.icon_name = file_type

  storage.icon_name.input.type = file_type
  storage.icon_name.input.name = file_name 

  execute run function dpi:file_item/get_icon_name with storage dpi:main icon_name.input:
    storage.icon_name.output.remove()
    $data modify storage dpi:main icon_name.output set from storage dpi:generated typed_icon_names."$(type)"
    $data modify storage dpi:main icon_name.output set from storage dpi:generated named_icon_names."$(name)"

  if not storage.icon_name.output:
    storage.icon_name.output = get_icon("generic_file")

  storage.modify_icon.input = {}
  storage.modify_icon.input.file_name = file_name
  storage.modify_icon.input.icon_name = storage.icon_name.output

  function dpi:file_item/modify_icon with storage dpi:main modify_icon.input
  
function dpi:file_item/modify_icon:
  $execute if items entity @s weapon.mainhand writable_book[custom_data~{dpi:{file_item:1b}}] run item modify entity @s weapon.mainhand [ { function:"minecraft:set_custom_model_data", strings:{ values:[$(icon_name)], mode:"replace_all" } }, { function:"minecraft:set_name", entity:"this", name:{text:$(file_name),italic:0b}, target:"custom_name" } ]

  $execute if items entity @s weapon.offhand writable_book[custom_data~{dpi:{file_item:1b}}] run item modify entity @s weapon.offhand [ { function:"minecraft:set_custom_model_data", strings:{values:[$(icon_name)],mode:"replace_all"} }, { function:"minecraft:set_name", entity:"this", name:{text:$(file_name),italic:0b}, target:"custom_name" } ]


item_modifier dpi:turn_equippable {
  "function": "minecraft:set_components",
  "components": {
    "minecraft:equippable": {
      "slot": "saddle"
    }
  }
}

def generate_item_models():
  ICONS_DIR = './src/assets/dpi/textures/file_item_icons/'
  cases = []

  for filename in os.listdir(ICONS_DIR):
    if filename.endswith('_file.png'):
      name = filename[:-4]
      
      model f"dpi:item/file_item/{name}" {
        "parent": "dpi:item/file_item_parent",
        "textures": {
          "layer0": f"dpi:file_item_icons/{name}"
        }
      }
      
      cases.append({
        "when": name,
        "model": {
          "type": "minecraft:model",
          "model": f"dpi:item/file_item/{name}"
        }
      })

  item_model dpi:file_item {
    "model": {
      "type": "minecraft:select",
      "property": "minecraft:custom_model_data",
      "cases": cases,
      "fallback": {
        "type": "minecraft:model",
        "model": "dpi:item/file_item/generic_file"
      }
    }
  }

generate_item_models()

