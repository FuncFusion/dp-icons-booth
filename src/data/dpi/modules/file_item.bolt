import bolt_expressions as expr
from dpi:config import var, storage, print_nbt, jump, get_icon
import os

append function dpi:tick/player:
  if predicate dpi:sneaking:
    if items entity @s weapon.mainhand writable_book[custom_data~{dpi:{file_item:true}}]:
      function dpi:string_input/submit

append function dpi:temp:
  clear amqndin
  as @a function dpi:file_item/give

function dpi:file_item/give:
  # change to other type of notification
  execute if items entity @s container.* writable_book[custom_data~{dpi:{file_item:1b}}] run return run say item already present in inventory
  execute if items entity @s enderchest.* writable_book[custom_data~{dpi:{file_item:1b}}] run return run say item already present in inventory
  give @s writable_book[
    consumable={consume_seconds:999999999},
    custom_data={
      summit:{ persist: {}, kill: true, callback: true },
      dpi:{ file_item:1b }
    },
    item_name="File",
    item_model="dpi:file_item",
    lore=[
      [
        {atlas:"items", sprite:"dpi:item/logos/deta_rack", color:"white", italic:false},
        " ",
        { text:"DATAPACK", font:"dpi:tooltip"},
        " ",
        {text:"ICONS",font:"dpi:tooltip"}
      ]
    ]
  ]

append function_tag summit.items:droppable/callback:
  values:
    - "dpi:file_item/dropped"

function dpi:file_item/dropped:
  say yo
  if items entity @s contents writable_book[custom_data~{dpi:{file_item:true}}]
    say gex

function dpi:string_input/submit:
  sio_output = storage.string_input.output
  character_limit = 48
  sio_length = var["#dpi.sio_length"]

  executor = expr.Data.entity("@s")
  sio_output = executor.SelectedItem.components."minecraft:writable_book_content".pages[0].raw
  sio_length = len(sio_output)

  if sio_length < character_limit:
    tellraw @a ["string_input.sio_output ", sio_output]
    function dpi:file_item/submit_name
  else:
    tellraw @a [
      {
        text:f"String can't be longer than {character_limit} characters!",
        color:"red"
      }
    ]

function dpi:file_item/submit_name:
  file_name = storage.temp.file_name
  data modify storage dpi:main split_string.input set from storage dpi:main string_input.output
  file_name = storage.split_string.input
  function dpi:split_string/init
  tellraw @a ["split string ", storage.split_string.output]

  storage.get_type.input = storage.split_string.output
  function dpi:get_type/init
  tellraw @a ["get_type ", storage.get_type.output]

  storage.join_string.input = storage.get_type.output
  function dpi:join_string/init
  tellraw @a ["join_string ", storage.join_string.output]

  file_type = storage.join_string.output

  tellraw @a ["file type ", file_type]

  storage.modify_icon.input.icon_name = file_type

  storage.icon_name.input.type = file_type
  storage.icon_name.input.name = file_name 

  execute run function dpi:file_item/get_icon_name with storage dpi:main icon_name.input:
    storage.icon_name.output.remove()
    $data modify storage dpi:main icon_name.output set from storage dpi:generated typed_icon_names."$(type)"
    $data modify storage dpi:main icon_name.output set from storage dpi:generated named_icon_names."$(name)"

  if not storage.icon_name.output:
    storage.icon_name.output = get_icon("generic_file")

  storage.modify_icon.input = {}
  storage.modify_icon.input.file_name = file_name
  storage.modify_icon.input.icon_name = storage.icon_name.output

  function dpi:file_item/modify_icon with storage dpi:main modify_icon.input
  
function dpi:file_item/modify_icon:

  $say icon_name = $(icon_name)
  $say file_name = $(file_name)
  $execute if items entity @s weapon.mainhand writable_book[custom_data~{dpi:{file_item:1b}}] run item modify entity @s weapon.mainhand [ { function:"minecraft:set_custom_model_data", strings:{ values:[$(icon_name)], mode:"replace_all" } }, { function:"minecraft:set_name", entity:"this", name:{text:$(file_name),italic:0b}, target:"custom_name" } ]

  $execute if items entity @s weapon.offhand writable_book[custom_data~{dpi:{file_item:1b}}] run item modify entity @s weapon.offhand [ { function:"minecraft:set_custom_model_data", strings:{values:[$(icon_name)],mode:"replace_all"} }, { function:"minecraft:set_name", entity:"this", name:{text:$(file_name),italic:0b}, target:"custom_name" } ]

function dpi:join_string/init:
  js_input = storage.join_string.input
  js_output = storage.join_string.output
  js_output = ""
  js_count = var["#dpi.js_count"]
  js_count = 0
  js_length = var["#dpi.js_length"]
  js_length = len(js_input)
  function dpi:join_string/main

function dpi:join_string/main:
  js_count += 1

  js_item = js_input[0]

  storage.join_string.default.input.str1 = js_output
  storage.join_string.default.input.str2 = js_item
  
  function dpi:join_string/default with storage dpi:main join_string.default.input

  js_output = storage.combined_string

  js_item.remove()
  
  if js_count < js_length:
    function dpi:join_string/main

function dpi:join_string/default:
  $data modify storage dpi:main combined_string set value "$(str1)$(str2)"

function dpi:get_type/init:
  gt_input = storage.get_type.input
  gt_output = storage.get_type.output
  gt_output = []
  gt_count = var["#dpi.gt_count"]
  gt_count = 0
  gt_length = var["#dpi.gt_length"]
  gt_length = len(gt_input)
  function dpi:get_type/main

function dpi:get_type/main:
  gt_count += 1

  gt_item = gt_input[-1]

  if gt_item == ".":
    return 0
  gt_output.prepend(gt_item)

  gt_item.remove()
  
  if gt_count < gt_length:
    function dpi:get_type/main

function dpi:split_string/init:
  input = storage.split_string.input[str]
  output = storage.split_string.output
  output = []
  count = var["#dpi.count"]
  count = 0
  length = var["#dpi.length"]
  length = len(input)
  function dpi:split_string/loop

function dpi:split_string/loop:
  count += 1
  output.append(input[0])
  storage.split_string.input = input[1:]
  if count < length:
    function dpi:split_string/loop

item_modifier dpi:turn_equippable {
  "function": "minecraft:set_components",
  "components": {
    "minecraft:equippable": {
      "slot": "saddle"
    }
  }
}

def generate_item_models():
  ICONS_DIR = './src/assets/dpi/textures/file_item_icons/'
  cases = []

  for filename in os.listdir(ICONS_DIR):
    if filename.endswith('_file.png'):
      name = filename[:-4]
      
      model f"dpi:item/file_item/{name}" {
        "parent": "dpi:item/file_item_parent",
        "textures": {
          "layer0": f"dpi:file_item_icons/{name}"
        }
      }
      
      cases.append({
        "when": name,
        "model": {
          "type": "minecraft:model",
          "model": f"dpi:item/file_item/{name}"
        }
      })

  item_model dpi:file_item {
    "model": {
      "type": "minecraft:select",
      "property": "minecraft:custom_model_data",
      "cases": cases,
      "fallback": {
        "type": "minecraft:model",
        "model": "dpi:item/file_item/generic_file"
      }
    }
  }

generate_item_models()

predicate dpi:sneaking {
  "condition": "minecraft:entity_properties",
  "entity": "this",
  "predicate": {
    "minecraft:flags": {
      "is_sneaking": true
    }
  }
}
