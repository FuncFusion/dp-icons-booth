from dpi:config import var, storage, print_nbt
import dpi:gui as gui
import bolt_expressions as expr

def get_icon(name):
    return {atlas:"items", sprite:"dpi:icons/" + name, shadow_color:0}

class Node:
  def __init__(self, name, type, parent=storage.fs.root):
    parent.child.append({})
    parent.child[-1].name = name
    parent.child[-1].type = type
    
    self._name = name
    self.parent = parent
    self.type = type

    if type == "dir":
      node = self.node()
      node.child = []
      self.child = node.child

  def node(self):
    return self.parent.child[{"name": self._name}]

  def remove(self):
    self.node.remove()

  def rename(self, new_name, type=self.type):
    self.parent.child[{"name": self._name}].name = new_name
    self._name = new_name

  def render(self, pos):
    x = pos[0]
    y = pos[1]
    z = pos[2]
    storage.node.render.input.node = self.node()
    execute positioned x y z run function dpi:node/render

  def walk(self):
    storage.fs.walk.input = self.node()
    function dpi:fs/walk/init

append function dpi:load:
  data modify storage dpi:main named_icons set value {
    "pack.mcmeta": get_icon("pack.mcmeta_file"),
    "src": get_icon("src_folder"),
    "load.json": get_icon("load.json_file"),
  }
  data modify storage dpi:main typed_icons set value {
    "dir": get_icon("generic_folder"),
    "json": get_icon("json_file"),
    "mcf": get_icon("mcfunction_file"),
  }

function dpi:node/render:
  input = storage.node.render.input.node
  right_click = "execute on target run say i right click"

  icon = storage.icon
  icon.remove()

  execute run function dpi:node/get_icon with storage dpi:main node.render.input.node:
    $data modify storage dpi:main icon set from storage dpi:main typed_icons."$(type)"
    $data modify storage dpi:main icon set from storage dpi:main named_icons."$(name)"

  if not icon:
    icon = get_icon("generic_file")

  message = [print_nbt("icon"), " ", print_nbt("node.render.input.node.name")]
  tellraw @a [*message, input.type]
  button = gui.Button("", right_click, message)
  button.spawn([0, 0, 0], "south", 4, 0.25)

function dpi:fs/walk/init:
  node = storage.fs.walk.input
  stack = storage.args.input
  stack = []
  stack.append(node.child)
  function dpi:fs/walk/main

function dpi:fs/walk/main:
  item = stack[-1][0]

  if item:
    tellraw @a [item.name, " ", item.type]

    if item.child:
      stack.append(item.child)
      function dpi:fs/walk/main

    item.remove()
    function dpi:fs/walk/main

  if stack[0] and not item:
    stack[-1].remove()

