from dpi:config import var, storage, print_nbt
import dpi:gui as gui
import bolt_expressions as expr

def get_icon(name):
    return {atlas:"items", sprite:"dpi:icons/" + name, shadow_color:0}

append function dpi:load:
  global_id = var["#dpi.node.global_id"]
  global_id = 0

class Node:
  def __init__(self, name, type, parent=storage.fs):
    self._name = name
    self.parent = parent
    self.type = type

    global_id = var["#dpi.node.global_id"]
    global_id += 1

    parent.children.append({})
    parent.children[-1].name = name
    parent.children[-1].type = type
    parent.children[-1].id = global_id

    if type == "dir":
      node = self.node()
      node.children = []
      self.children = node.children

  def node(self):
    return self.parent.children[{"name": self._name}]

  def remove(self):
    self.node.remove()

  def rename(self, new_name, type=self.type):
    self.parent.children[{"name": self._name}].name = new_name
    self._name = new_name

  def render(self, pos):
    x = pos[0]
    y = pos[1]
    z = pos[2]
    storage.node.render.input.node = self.node()
    execute positioned x y z run function dpi:node/render

  def walk(self):
    storage.fs.walk.input = self.node()
    function dpi:fs/walk/init

function dpi:fs/walk/init:
  node = storage.fs.walk.input
  stack = storage.args.input
  stack = []
  stack.append(node.children)
  function dpi:fs/walk/main

function dpi:fs/walk/main:
  item = stack[-1][0]

  if item:
    tellraw @a [item.name, " ", item.type]

    if item.children:
      stack.append(item.children)
      function dpi:fs/walk/main

    item.remove()
    function dpi:fs/walk/main

  if stack[0] and not item:
    stack[-1].remove()
