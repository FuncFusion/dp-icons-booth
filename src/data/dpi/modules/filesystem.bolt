from dpi:config import var, storage
import dpi:gui as gui
import bolt_expressions as expr

named_icons = {
  "pack.mcmeta": "pack.mcmeta_file",
  "src": "src_folder",
}

def get_icon(name):
    return {atlas:"items", sprite:"dpi:icons/" + name, shadow_color:0}

class Node:
  def __init__(self, name, type, parent=storage.fs.root):
    parent.child.append({})
    parent.child[-1].name = name
    parent.child[-1].type = type
    
    self._name = name
    self.parent = parent
    self.type = type

    if type == "dir":
      node = self.node()
      node.child = []
      self.child = node.child

  def node(self):
    return self.parent.child[{"name": self._name}]

  def remove(self):
    self.node.remove()

  def rename(self, new_name, type=self.type):
    self.parent.child[{"name": self._name}].name = new_name
    self._name = new_name

  def render(self, pos, face):
    right_click = "execute on target run say i right click"

    if self._name in named_icons:
      icon_name = named_icons[self._name]
      icon = get_icon(icon_name)

    message = [icon, " ", self._name]
    print(message)
    button = gui.Button("", right_click, message)
    button.spawn(pos, face, 4, 0.25)

  def walk(self):
    raw # walking
    storage.fs.walk.input = self.node()
    function dpi:fs/walk/init

append function dpi:load:
    function dpi:temp

function dpi:temp:
  root = Node("root", "dir")
  pack = Node("src", "dir")
  pack.render([113, 87, -113], "north")

function dpi:fs/walk/init:
  node = storage.fs.walk.input
  stack = storage.args.input
  stack = []
  stack.append(node.child)
  function dpi:fs/walk/main

function dpi:fs/walk/main:
  item = stack[-1][0]

  if item:
    tellraw @a [item.name, " ", item.type]

    if item.child:
      stack.append(item.child)
      function dpi:fs/walk/main

    item.remove()
    function dpi:fs/walk/main

  if stack[0] and not item:
    stack[-1].remove()

