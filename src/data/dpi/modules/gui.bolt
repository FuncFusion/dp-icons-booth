def get_icon(name):
    return """{atlas:"items", sprite:"dpi:icons/""" + name + """, shadow_color:0}"""

class Window:
    def __init__(self, width, height):
        self.width = width
        self.height = height

    def spawn():
        summon text_display ~ ~ ~ {
            Tags: ["dpi.window"],
            alignment: "center",
            text: self.text
        }

