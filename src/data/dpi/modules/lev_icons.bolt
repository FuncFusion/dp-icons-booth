def ease_out_cubic(t):
    return 1 - pow(1 - t, 3)

def ease_in_out_asymmetric(t):
    return (t**2.5) / (t**2.5 + pow(1 - t, 1.5))

def lerp(start, end, t):
    return start + (end - start) * t

def tp_path(x, y, z, icon_name, transition_duration=0.75, easing_type="out"):
    total_ticks = int(transition_duration / 0.05)
    commands = []

    prev_pos = [0, 0, 0]
    if easing_type == "in":
        x = x*-1
        y = y*-1
        z = z*-1
    
    for tick in range(1, total_ticks + 1):
        progress = (tick * 0.05) / transition_duration
        
        prefix = ""
        if easing_type == "out":
            prefix = "out_"
            eased_progress = ease_out_cubic(progress)
        else:
            prefix = "in_"
            eased_progress = ease_in_out_asymmetric(progress)

        current_pos = [
            lerp(0, x/16, eased_progress),
            lerp(0, y/16, eased_progress),
            lerp(0, z/16, eased_progress)
        ]
        
        dx = round(current_pos[0] - prev_pos[0], 5)
        dy = round(current_pos[1] - prev_pos[1], 5)
        dz = round(current_pos[2] - prev_pos[2], 5)

        schedule function f"dpi:lev_icons/{icon_name}/{prefix}{tick}" tick replace:
            execute as @n[tag=f"dpi.aj.lev_icons.bone.{icon_name}"] at @s run tp @s ~dx ~dy ~dz

        prev_pos = current_pos
        
    return commands

append function dpi:tick:
    pass

function dpi:lev_icons/fly_out:
    tp_path(16,10,-19, "mcf_tick")
    tp_path(-34,31,20, "python")
    tp_path(30,52,46, "structure_file")
    tp_path(-9,-16,-19, "json_file")

function dpi:lev_icons/fly_in:
    tp_path(9,5,-14, "mcf_tick", easing_type="in")
    tp_path(-34,31,20, "python", easing_type="in")
    tp_path(30,52,46, "structure_file", easing_type="in")
    tp_path(-9,-16,-19, "json_file", easing_type="in")


