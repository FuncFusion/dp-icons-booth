function dpi:exit_portal/on_player_enter:
  tp @s 114.42 95.00 -124.30 -179.48 8.78
  at @s playsound minecraft:item.chorus_fruit.teleport player @s ~ ~ ~
  function dpi:stickers/end_speedrun
