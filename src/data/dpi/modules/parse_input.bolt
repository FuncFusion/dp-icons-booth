from dpi:config import storage, var
import bolt_expressions as expr

function dpi:parse_input/init:
  sio_has_slash = var["#dpi.sio_has_slash"]
  sio_has_slash = 0
  raw_name = storage.parse_input.input.raw_name[str]

  function dpi:split_string/init

  last_char = storage.split_string.output[-1]

  if last_char == "/":
    sio_has_slash = 1
    storage.parse_input.output.file_name = raw_name[:-1]
    storage.parse_input.output.type = "dir"
  else:
    storage.get_type.input = storage.split_string.output
    function dpi:get_type/init

    storage.join_string.input = storage.get_type.output
    function dpi:join_string/init

    storage.parse_input.output.file_name = raw_name
    storage.parse_input.output.type = storage.join_string.output


function dpi:split_string/init:
  input = storage.split_string.input[str]
  output = storage.split_string.output
  output = []
  count = var["#dpi.count"]
  count = 0
  length = var["#dpi.length"]
  length = len(input)
  function dpi:split_string/loop

function dpi:split_string/loop:
  count += 1


  output.append(input[0])
  storage.split_string.input = input[1:]
  if count < length:
    function dpi:split_string/loop

function dpi:get_type/init:
  gt_input = storage.get_type.input
  gt_output = storage.get_type.output
  
  sio_has_slash = var["#dpi.sio_has_slash"]
  if sio_has_slash == 1:
    gt_output = ["d","i","r"]
  
  if sio_has_slash == 0:
    gt_output = []
    gt_count = var["#dpi.gt_count"]
    gt_count = 0
    gt_length = var["#dpi.gt_length"]
    gt_length = len(gt_input)
    function dpi:get_type/main

function dpi:get_type/main:
  gt_count += 1

  gt_item = gt_input[-1]

  if gt_item == ".":
    return 0
  gt_output.prepend(gt_item)

  gt_item.remove()
  
  if gt_count < gt_length:
    function dpi:get_type/main

function dpi:join_string/init:
  js_input = storage.join_string.input
  js_output = storage.join_string.output
  js_output = ""
  js_count = var["#dpi.js_count"]
  js_count = 0
  js_length = var["#dpi.js_length"]
  js_length = len(js_input)
  function dpi:join_string/main

function dpi:join_string/main:
  js_count += 1

  js_item = js_input[0]

  storage.join_string.default.input.str1 = js_output
  storage.join_string.default.input.str2 = js_item
  
  function dpi:join_string/default with storage dpi:main join_string.default.input

  js_output = storage.combined_string

  js_item.remove()
  
  if js_count < js_length:
    function dpi:join_string/main

function dpi:join_string/default:
  $data modify storage dpi:main combined_string set value "$(str1)$(str2)"
