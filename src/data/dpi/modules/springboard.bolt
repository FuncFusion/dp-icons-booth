from dpi:config import var, jump, player_motion_api
import bolt_expressions as expr
import dpi:stickers as stickers

prefix = "#dpi.springboard."
p = prefix

append function dpi:load:
  timer = expr.Scoreboard.objective("dpi.springboard.timer", "dummy")
  var[p + "springboard.animation_guard"] = 0
  animation_guard = var[p + "animation_guard"]
  stepped = var[p + "stepped"]
  ready = var[p + "ready"]
  arrow_pos = var[p + "arrow_pos"]
  arrow_pos = 0

append function dpi:tick/booth_entity:
  if entity @s[tag=dpi.aj.springboard.root] run function dpi:springboard/tick

append function dpi:tick/booth_player:
  if stepped:
    if entity @s[tag=dpi.springboard.bounding_box] function dpi:springboard/prime

function dpi:springboard/on_player_enter:
  tag @s add dpi.springboard.bounding_box
  stepped = 1
  function dpi:springboard/prime

function dpi:springboard/on_player_exit:
  tag @s remove dpi.springboard.bounding_box
  unless entity @p[tag=dpi.springboard.bounding_box]:
    stepped = 0
  tag @s remove dpi.springboard.pending

function dpi:springboard/prime:
  if entity @s[tag=!dpi.springboard.pending]:
    if jump["@s"]:
      jump["@s"] = 0

    tag @s add dpi.springboard.pending
    timer["@s"] = 14

  if timer["@s"]:
    timer["@s"] -= 1

  if jump["@s"] and timer["@s"] == 0:
    player_motion_api["$x"] = 0
    player_motion_api["$y"] = 22000
    player_motion_api["$z"] = 5000

    jump["@s"] = 0

    as @a[tag=summit.booth_entity.dpi,tag=dpi.springboard.pending] at @s:
     function player_motion:api/launch_global_xyz
     function dpi:stickers/start_speedrun

    tag @s remove dpi.springboard.pending

  if jump["@s"]:
    jump["@s"] = 0

function dpi:springboard/tick:
  if stepped and not animation_guard:
    animation_guard = 1
    function dpi:aj/springboard/animations/animation_springboard_prime/play

  if not stepped and animation_guard:
    animation_guard = 0
    function dpi:aj/springboard/animations/animation_springboard_bounce/play

function dpi:springboard/loop_22t_arrow:
  arrow_pos -= 1
  arrow_pos *= -1
  if arrow_pos == 0:
    tp 7f8bd0c1-7db5-4438-a066-b701bc411a3c 114.5 93.8 -132.0
  else:
    tp 7f8bd0c1-7db5-4438-a066-b701bc411a3c 114.5 94.3 -131.7
