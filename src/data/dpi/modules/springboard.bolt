from dpi:config import var, jump, player_motion_api

append function dpi:tick/booth_entity:
  if entity @s[tag=dpi.aj.springboard.root] run function dpi:springboard/tick

append function dpi:tick/player:
  if entity @s[x=113, y=93, z=-135, dx=2, dy=0, dz=2] run function dpi:springboard/prime
  if jump["@s"]:
    jump["@s"] = 0

function dpi:springboard/prime:
  if jump["@s"]:
    player_motion_api["$x"] = 0
    player_motion_api["$y"] = 22000
    player_motion_api["$z"] = 7000

    jump["@s"] = 0

    function player_motion:api/launch_global_xyz
    as @n[tag=dpi.aj.chest_house.root] run function dpi:aj/chest_house/animations/chest_open/play

function dpi:springboard/tick:
  execute
    store result score #dpi.springboard.stepped dpi.var
    if entity @p[x=113, y=93, z=-135, dx=2, dy=0, dz=2]

  if var["#dpi.springboard.stepped"] and not var["#animation_guard"]:
    var["#animation_guard"] = 1
    function dpi:aj/springboard/animations/animation_springboard_prime/play

  if not var["#dpi.springboard.stepped"] and var["#animation_guard"]:
    var["#animation_guard"] = 0
    function dpi:aj/springboard/animations/animation_springboard_bounce/play
