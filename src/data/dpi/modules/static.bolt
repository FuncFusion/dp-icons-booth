dialog dpi:timeline {
  "type": "minecraft:notice",
  "title": [{"atlas":"items","sprite":"dpi:icons/timeline_file"}," More fun facts"],
  "body": {
    "type": "minecraft:plain_message",
    "contents": ["",{"text": "1.0", "color":"#c9e2ff"}," was released on March 31st, 2023. The project is more than ",{"text": "3 years old!", "color":"gold"},"\n\nFor one of the authors of this project, ",{"text": "SuperAnt_", "color":"#E88425"},", this project was his first ever github repository! It was also our first VS Code extension.\n\nThis extension works in ",{"text": "web version","color":"aqua"}," of VS Code, but with limited features.\n\nWe have created ",{"text": "7","bold":true,"color":"#8599ff"}," discord servers just to fill them with our icons as custom emojis, to use anywhere with nitro."],
    "width": 220
  },
  "action": {
    "label": "Cool!"
  }
}

dialog dpi:did_watch_trailer {
  "type": "minecraft:confirmation",
  "title": "",
  "body": {
    "type": "minecraft:plain_message",
    "contents": ["Have you watched the ",{"text": "5.0", "color":"#4488e0"}," trailer yet? 🙃"],
    "width": 220
  },
  "can_close_with_escape": true,
  "yes": {
    "label": "Yes!",
    "action": {
      "type": "minecraft:run_command",
      "command": "advancement grant @s only summit.sticker_book:dpi/trailer"
    }
  },
  "no": {
    "label": "Not yet",
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": {
        "type": "minecraft:confirmation",
        "title": "",
        "body": {
          "type": "minecraft:plain_message",
          "contents": ["Come back after watching the trailer to get a ",{"text": "sticker","color": "light_purple"},"!"]
        },
        "yes": {
          "label": "Open trailer link",
          "action": {
            "type": "minecraft:open_url",
            "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
          }
        },
        "no": {
          "label": "Later"
        }
      }
    }
  }
}

dialog dpi:used_by_links {
  "type": "minecraft:multi_action",
  "title": [{"atlas":"items","sprite":"dpi:icons/lang_file"}," Used By"],
