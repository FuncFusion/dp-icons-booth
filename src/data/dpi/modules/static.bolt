dialog dpi:zed_port_link:
  add_url_dialogue("dpi:icons/misc/antbot/link", "Zed port", "https://github.com/FuncFusion/mc-dp-icons-zed")

dialog dpi:dp_essentials_link:
  add_url_dialogue("dpi:icons/function_folder", "Datapack Essentials - Extension Pack", "https://marketplace.visualstudio.com/items?itemName=amandin.dpc-pack")

dialog dpi:ant_github_link:
  add_url_dialogue("dpi:icons/misc/antbot/github", "SuperAnt_'s Github", "https://github.com/SuperAnt220")

dialog dpi:ant_modrinth_link:
