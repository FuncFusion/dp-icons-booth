def add_url_dialogue(icon, title, url):
  pattern = r"^(?:https?://)?(?:www\.)?(.+)"

  domain = re.sub(pattern, r"\1", url)

  return {
    "type": "minecraft:confirmation",
    "title": [{atlas:"items",sprite: icon}," ",{text: title}],
    "external_title": "",
    "body": {
      "type": "minecraft:plain_message",
      "contents": {
        "text": domain,
        "color": "yellow",
        "underlined": true
      },
      "width": 500
    },
    "inputs": [],
    "can_close_with_escape": true,
    "after_action": "close",
    "yes": {
      "label": "Open link",
      "action": {
        "type": "minecraft:open_url",
        "url": url
      }
    },
    "no": {
      "label": "Close"
    }
  }

dialog dpi:trailer_link:
  add_url_dialogue("dpi:icons/video_file", "Watch 5.0 trailer!", "https://www.youtube.com/watch?v=dQw4w9WgXcQ")

dialog dpi:main_repo_link:
  add_url_dialogue("dpi:icons/misc/antbot/github", "Check out the extension's repository!", "https://github.com/FuncFusion/mc-dp-icons")

