      "width": 180,
      "action": {
        "type": "minecraft:open_url",
        "url": "https://github.com/vyfor/cord.nvim"
      }
    },
    {
      "label": {"text": "Animated Java website and docs", "color": "#76daff"},
      "tooltip": [
        "Effortlessly craft complex animations for Minecraft: Java Edition. ",
        {
          "text": "It also has a booth here!",
          "color": "green"
        }
      ],
      "width": 180,
      "action": {
        "type": "minecraft:open_url",
        "url": "https://animated-java.dev/"
      }
    },
    {
      "label": {"text":"Rhombus","color":"#d7ccff"},
