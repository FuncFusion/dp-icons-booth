    "type": "minecraft:plain_message",
    "contents": [{"atlas":"items","sprite":"dpi:icons/dimension_file"}," Check out our friends at ",{"text":"Shard","color":"light_purple"},{"text":"gate","color":"green"}," Studios!\n\nThey make cool ",{"text":"datapacks","color":"#FF631A"},", ",{"text":"maps","color":"#CE231F"},", ",{"text":"minecraft servers","color":"gold"},", and ",{"text":"indie games","color":"#00ADEE"},"!","\n\nDo you want to teleport to their booth?"],
