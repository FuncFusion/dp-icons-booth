from dpi:config import var
import bolt_expressions as expr

append function dpi:load:
  speedrun_timer = expr.Scoreboard.objective("dpi.speedrun.timer", "dummy")
  secs = var["#dpi.speedrun.secs"]
  ms = var["#dpi.speedrun.ms"]
  ms_prefix = var["#dpi.speedrun.ms_prefix"]
  ms_prefix2 = var["#dpi.speedrun.ms_prefix2"]

append function dpi:tick/booth_player:
  if speedrun_timer["@s"]:
    speedrun_timer["@s"] -= 1

function dpi:exit_portal/on_player_exit:
  if speedrun_timer["@s"] <= 0:
    speedrun_timer["@s"].reset()
  
function dpi:stickers/start_speedrun:
  speedrun_timer["@s"] = 199

function dpi:stickers/end_speedrun:
  if speedrun_timer["@s"]:
    function dpi:stickers/speedrun_time_calc
    if speedrun_timer["@s"] <= 79:
      title @s title ["Time: ",{text:"0", color:"red", extra:[{score:{objective:"dpi.var",name:"#dpi.speedrun.secs"}},".",{score:{objective:"dpi.var",name:"#dpi.speedrun.ms_prefix"}},{score:{objective:"dpi.var",name:"#dpi.speedrun.ms_prefix2"}},{score:{objective:"dpi.var",name:"#dpi.speedrun.ms"}}]}]
    else:
      title @s title ["Time: ",{text:"0", color:"green", extra:[{score:{objective:"dpi.var",name:"#dpi.speedrun.secs"}},".",{score:{objective:"dpi.var",name:"#dpi.speedrun.ms_prefix"}},{score:{objective:"dpi.var",name:"#dpi.speedrun.ms_prefix2"}},{score:{objective:"dpi.var",name:"#dpi.speedrun.ms"}}]}]
      advancement grant @s only summit.sticker_book:dpi/speedrun
    scoreboard players reset #dpi.speedrun.ms_prefix dpi.var
    scoreboard players reset #dpi.speedrun.ms_prefix2 dpi.var

function dpi:stickers/speedrun_time_calc:
  ticks = 199 - speedrun_timer["@s"]
  secs = ticks / 20
  ms = ticks % 20 * 50
  if ms == 50:
    ms_prefix = 0
  if ms == 0:
    ms_prefix = 0
    ms_prefix2 = 0

function dpi:stickers/completion:
  advancement grant @s only summit.sticker_book:dpi/completion

def generate_completion_advancement(tags):
    criteria = {}
    requirements = []

    for tag in tags:
        key = tag.split('.')[-1]
        key_punch = f"{key}_punch"

        criteria[key] = {
            "trigger": "minecraft:player_interacted_with_entity",
            "conditions": {
                "entity": {
                    "minecraft:entity_tags": {
                        "any_of": [tag]
                    }
                }
            }
        }

        criteria[key_punch] = {
            "trigger": "minecraft:player_hurt_entity",
            "conditions": {
                "entity": {
                    "minecraft:entity_tags": {
                        "any_of": [tag]
                    }
                }
            }
        }
        requirements.append([key, key_punch])

    advancement dpi:stickers/completion {
        "criteria": criteria,
        "requirements": requirements,
        "rewards": {
            "function": "dpi:stickers/completion"
        }
    }

generate_completion_advancement([
    "dpi.button.trailer_link", 
    "dpi.button.assets_repo_link",
    "dpi.button.discord_link",
    "dpi.button.issues_link",
    "dpi.button.sublime_port_link",
    "dpi.button.sublime_port_link",
    "dpi.button.emerald_sticker",
    "dpi.button.main_repo_link",
    "dpi.button.timeline",
    "dpi.button.did_watch_trailer",
    "dpi.button.used_by_links",
    "dpi.button.shardgate_tp",
    "dpi.button.ant_github_link",
    "dpi.button.ant_modrinth_link",
    "dpi.button.dp_essentials_link",
    "dpi.button.amandin_github_link",
    "dpi.button.ant_balloon",
    "dpi.waiting_for_click",
    "dpi.node.context_menu.rename",
    "dpi.node.context_menu.remove",
    "dpi.node.context_menu.create_file",
    "dpi.node.context_menu.create_dir",
])
