from dpi:config import storage, var
import bolt_expressions as expr

update_tree = var["#dpi.tree.update_pending"]
create_supplied_type = var["#dpi.create_supplied_type"]
id = expr.Scoreboard.objective("dpi.node_id", "dummy")
global_id = var["#dpi.node.global_id"]

root = storage.fs.root
stack = storage.rebuild.args
output = storage.rebuild.output
entry = storage.temp.entry

append function dpi:tick/player:
  if predicate dpi:sneaking:
    if items entity @s weapon.mainhand writable_book[custom_data~{dpi:{create_input:true}}]:
      function dpi:node/create/submit

function dpi:node/create/book:
  execute if entity @s[tag=dpi.tree.banned] run return run title @s actionbar {text:"You are banned from creating/renaming files and folders",color:"red"}
  execute if entity @s[tag=dpi.pending] run return run title @s actionbar {text:"You already have a pending creation!",color:"red"}
  tag @s add dpi.pending
  item modify entity @s weapon.mainhand dpi:turn_equippable
  item replace entity @s saddle from entity @s weapon.mainhand
  item replace entity @s weapon.mainhand with writable_book[
    custom_data={
      dpi:{create_input:true}
    }
  ] 1

function dpi:node/create/submit:
  sio_output = storage.string_input.output
  sio_length = var["#dpi.sio_length"]

  executor = expr.Data.entity("@s")
  sio_output = executor.SelectedItem.components."minecraft:writable_book_content".pages[0].raw
  sio_length = len(sio_output)

  if sio_length < 48:
    item replace entity @s weapon.mainhand from entity @s saddle
    tag @s remove dpi.pending

    if create_supplied_type == 1:
      create_supplied_type = 0
      storage.node.create.input.file_name = sio_output
      storage.node.create.input.type = "dir"
    else:
      storage.parse_input.input.raw_name = sio_output
      storage.split_string.input = sio_output
      function dpi:parse_input/init
      storage.node.create.input.file_name = storage.parse_input.output.file_name
      storage.node.create.input.type = storage.parse_input.output.type

    as @n[tag=dpi.node.selected]:
      parent_id = var["#dpi.parent_id"]
      parent_id = id["@s"]
      function dpi:node/create
      function dpi:node/unselect
  else:
    tellraw @a [{text:"String can't be longer than 48 characters!", color:"red"}]

function dpi:node/create:
  parent_id = var["#dpi.parent_id"]
  function dpi:node/create/init

function dpi:node/create/init:
  stack.node = []
  stack.node.append(root)
  stack.new_children = []
  stack.loops = []

  function dpi:node/create/main

  root = output
  update_tree = 1

function dpi:node/create/main:
  stack.new_children.append([])
  node = stack.node[-1]
  parent_id = var["#dpi.parent_id"]

  if node.children:
    stack.loops.append(node.children)
    function dpi:node/create/children
    stack.loops[-1].remove()

  if node.id == parent_id:
    create_input = storage.node.create.input
    global_id += 1
    new_child = storage.temp.new_child
    new_child.name = create_input.file_name
    new_child.type = create_input.type
    new_child.id = global_id
    if create_input.type == "dir":
      new_child.children = []
    stack.new_children[-1].append(new_child)

  entry.name = node.name
  entry.type = node.type
  entry.id = node.id

  entry.closed.remove()
  entry.hidden.remove()
  if node.closed:
    entry.closed = true
  if node.hidden:
    entry.hidden = true

  current_collected = stack.new_children[-1]
  if current_collected[0]:
    entry.children = current_collected
  else:
    entry.children.remove()

  stack.new_children[-1].remove()
  stack.node[-1].remove()

  if stack.new_children[0]:
    stack.new_children[-1].append(entry)
  else:
    output = entry

function dpi:node/create/children:
  current_layer = stack.loops[-1]
  child = current_layer[0]
  parent_id = var["#dpi.parent_id"]

  if child:
    if child.id == parent_id and not child.children:
      create_input = storage.node.create.input
      global_id += 1
      new_child = storage.temp.new_child
      new_child.name = create_input.file_name
      new_child.type = create_input.type
      new_child.id = global_id
      if create_input.type == "dir":
        new_child.children = []
      stack.new_children[-1].append(new_child)
      parent_id = 0

    stack.node.append(child)
    function dpi:node/create/main

  current_layer[0].remove()
  if current_layer[0]:
    function dpi:node/create/children
