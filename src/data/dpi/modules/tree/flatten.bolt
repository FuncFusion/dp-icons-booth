from dpi:config import storage, var, print_nbt

function dpi:tree/flatten/init:
  node = storage.tree.flatten.input

  depth = var["#dpi.fs.depth"]
  depth = 1

  snapshot = storage.tree.snapshot
  storage.tree.old_snapshot = snapshot
  snapshot = []

  stack = storage.args.input
  stack = []
  stack.append(node.children)

  state = storage.state

  function dpi:tree/flatten/main

function dpi:tree/flatten/main:
  item = stack[-1][0]

  if item:
    raw function dpi:tree/flatten/preserve_state with storage dpi:main args.input[-1][0]

    if state:
      if not state.removed:
        snapshot.append(state)
    else:
      snapshot.append({name:"", depth:0})
      snapshot[-1].name = item.name
      snapshot[-1].type = item.type
      snapshot[-1].id = item.id
      snapshot[-1].depth = depth

    if item.children:
      stack.append(item.children)
      depth += 1
      function dpi:tree/flatten/main
      depth -= 1

    item.remove()
    function dpi:tree/flatten/main

  if not item:
    if stack[0]:
      stack[-1].remove()

function dpi:tree/flatten/preserve_state:
  state.remove()
  $data modify storage dpi:main state set from storage dpi:main tree.old_snapshot[{id:$(id)}]
