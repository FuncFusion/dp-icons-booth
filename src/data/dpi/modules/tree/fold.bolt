import bolt_expressions as expr
from dpi:config import storage, var, print_nbt

update_tree = var["#dpi.tree.update_pending"]
update_snapshot = var["#dpi.tree.snapshot.update_pending"]

function dpi:node/fold:
  entity = expr.Data.entity("@s")
  match = storage.node.match
  match = entity.data.node

  if match.closed:
    entity.data.node.closed.remove()
    function dpi:node/expand/init
  else:
    entity.data.node.closed = true
    function dpi:node/collapse/init

function dpi:node/expand/init:
  snapshot = storage.tree.snapshot

  tellraw @a ["matching ", match, " in ", snapshot]

  count = var["#dpi.count"]
  count = 0
  matched_depth = var["#dpi.matched_depth"]
  matched_depth = 0
  depth = var["#dpi.depth"]
  depth = 0

  length = len(snapshot)
  function dpi:node/expand/main

function dpi:node/expand/main:
  item = snapshot[0]
  count += 1

  tellraw @a ["ITER ", count, " name=", item.name, " depth=", item.depth, " matched=", matched_depth]

  match_found = var["#dpi.match"]
  match_found = 0
  function dpi:node/compare

  if matched_depth:
    depth = item.depth
    if depth > matched_depth:
      tellraw @a ["  REMOVE ", item.name, " (depth ", depth, " > ", matched_depth, ")"]
      item.collapsed.remove()
    else:
      tellraw @a ["  STOP at ", item.name, " (depth ", depth, " <= ", matched_depth, ")"]
      matched_depth = 0

  if match_found:
    item.closed.remove()
    tellraw @a ["  MATCH ", item.name, " depth=", item.depth, " set matched_depth=", item.depth]
    matched_depth = item.depth
    update_tree = 1
    update_snapshot = 0

  snapshot.append(item)
  item.remove()
  if count < length:
    function dpi:node/expand/main






function dpi:node/collapse/init:
  snapshot = storage.tree.snapshot

  tellraw @a ["matching ", match, " in ", snapshot]

  count = var["#dpi.count"]
  count = 0
  matched_depth = var["#dpi.matched_depth"]
  matched_depth = 0
  depth = var["#dpi.depth"]
  depth = 0

  length = len(snapshot)
  function dpi:node/collapse/main

function dpi:node/collapse/main:
  item = snapshot[0]
  count += 1

  tellraw @a ["ITER ", count, " name=", item.name, " depth=", item.depth, " matched=", matched_depth]

  match_found = var["#dpi.match"]
  match_found = 0
  function dpi:node/compare

  if matched_depth:
    depth = item.depth
    if depth > matched_depth:
      tellraw @a ["  REMOVE ", item.name, " (depth ", depth, " > ", matched_depth, ")"]
      item.collapsed = true
    else:
      tellraw @a ["  STOP at ", item.name, " (depth ", depth, " <= ", matched_depth, ")"]
      matched_depth = 0

  if match_found:
    item.closed = true
    tellraw @a ["  MATCH ", item.name, " depth=", item.depth, " set matched_depth=", item.depth]
    matched_depth = item.depth
    update_tree = 1
    update_snapshot = 0

  snapshot.append(item)
  item.remove()
  if count < length:
    function dpi:node/collapse/main

function dpi:node/compare:
  item = snapshot[0]
  match_found = var["#dpi.match"]
  storage.temp = match
  execute store success score f"#dpi.match" dpi.var
    run data modify storage dpi:main temp set from storage dpi:main tree.snapshot[0]

  execute store success score f"#dpi.match" dpi.var
    if score f"#dpi.match" dpi.var matches 0

