import dpi:gui as gui
from dpi:config import storage, var, print_nbt
from dpi:filesystem import Node
import dpi:icons as icons
import bolt_expressions as expr

update_tree = var["#dpi.tree.update_pending"]
update_snapshot = var["#dpi.tree.snapshot.update_pending"]

class Tree:
  def __init__(self):
    self.root = Node("root", "dir")

  def render(self):
    storage.tree.render.input = self.root.node()
    execute positioned ~ ~ ~ run function dpi:tree/render/init
    function dpi:tree/render/presets

  def kill(self):
    kill @e[tag=dpi.tree.node]

  def update(self):
    update_tree = var["#dpi.tree.update_pending"]
    self.kill()
    self.render()
    update_tree = 0
