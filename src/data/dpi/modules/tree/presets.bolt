from dpi:filesystem import Node
from dpi:trigger_actions import Action
from dpi:config import storage, var, print_nbt, global_tick
import dpi:gui as gui
import bolt_expressions as expr

PRESETS = {
    "datapack":1,
    "resourcepack":2,
    "bedrock":3,
    "beet":4,
    "sandstone":5,
    "fabric":6,
    "plugin":7,
    "python":8,
    "web":9,
    "server":10,
    "repo":11,
    "dotfiles":12,
    "misc":13
  }

advancement_requirements = []
for name in PRESETS.keys():
    advancement f"dpi:preset/visited/{name}" {
        "criteria": {
            "impossible": {
                "trigger": "minecraft:impossible"
            }
        }
    }
    advancement_requirements.append(f"dpi:preset/visited/{name}")

function dpi:preset/visited_all:
  visited_all = var["#dpi.presets.visited_all"]
  visited_all = 1
  
  # all_advancement_check = []

  for advancement in advancement_requirements:
    unless entity @s[advancements={advancement=true}]:
      visited_all = 0

  if visited_all:
    advancement grant @s only summit.sticker_book:dpi/tree

preset_index = var["#dpi.tree.preset_index"]
preset_amount = var["#dpi.tree.preset_amount"]
update_tree = var["#dpi.tree.update_pending"]
xmas_theme = var["#dpi.xmas_theme"]
preset_cd = expr.Scoreboard.objective("dpi.preset_cd", "dummy")

function dpi:xmas/toggle:
  execute on attacker if entity @a[tag=dpi.pending] unless entity @s[tag=dpi.pending] run return run title @s actionbar {text:"Someone else is using the tree!",color:"red"}
  execute on target if entity @a[tag=dpi.pending] unless entity @s[tag=dpi.pending] run return run title @s actionbar {text:"Someone else is using the tree!",color:"red"}

  if xmas_theme:
    xmas_theme = 0
  else:
    xmas_theme = 1
  update_tree = 1

function dpi:tree/render/presets:
  kill @e[type=#taglib:markerlike,tag=dpi.tree.preset_display]

  preset_display = gui.Button("", "", print_nbt("fs.preset_name"))
  execute positioned 110.25 84.55 -123.95:
    preset_display.spawn("south", 2, 0.25, tags=["dpi.tree.preset_display"])

  cycle_next_lmb = "execute on attacker run function dpi:tree/preset/cycle_next"
  cycle_next_rmb = "execute on target run function dpi:tree/preset/cycle_next"

  cycle_next_button = gui.Button(cycle_next_lmb, cycle_next_rmb, "next ➡")
  execute positioned 110.75 84.25 -123.95:
    cycle_next_button.spawn("south", 1, 0.25, tags=["dpi.tree.preset_display"])

  cycle_back_lmb = "execute on attacker run function dpi:tree/preset/cycle_back"
  cycle_back_rmb = "execute on target run function dpi:tree/preset/cycle_back"

  cycle_back_button = gui.Button(cycle_back_lmb, cycle_back_rmb, "⬅ back")
  execute positioned 109.75 84.25 -123.95:
    cycle_back_button.spawn("south", 1, 0.25, tags=["dpi.tree.preset_display"])

  if xmas_theme:
    storage.xmas_button_text = {text:"🎄 Xmas", color:"green"}
  else:
    storage.xmas_button_text = {text:"❄ Xmas", color:"dark_gray"}
  xmas_toggle = gui.Button("function dpi:xmas/toggle", "function dpi:xmas/toggle", print_nbt("xmas_button_text"))
  execute positioned 110.25 85.1 -123.95:
    xmas_toggle.spawn("south", 1, 0.25, tags=["dpi.tree.preset_display"])

function dpi:tree/preset/cycle_back:
  function dpi:preset/visited_all
  if entity @a[tag=dpi.pending] unless entity @s[tag=dpi.pending] run return run title @s actionbar {text:"Someone else is using the tree!",color:"red"}

  elapsed = var["#dpi.preset_elapsed"]
  elapsed = global_tick
  elapsed -= preset_cd["@s"]
  if elapsed < 10:
    return 0

  preset_cd["@s"] = global_tick
  preset_index -= 1
  function dpi:tree/preset/apply_preset

function dpi:tree/preset/cycle_next:
  function dpi:preset/visited_all
  if entity @a[tag=dpi.pending] unless entity @s[tag=dpi.pending] run return run title @s actionbar {text:"Someone else is using the tree!",color:"red"}

  elapsed = var["#dpi.preset_elapsed"]
  elapsed = global_tick
  elapsed -= preset_cd["@s"]
  if elapsed < 10:
    return 0

  preset_cd["@s"] = global_tick
  preset_index += 1
  function dpi:tree/preset/apply_preset

function dpi:tree/preset/apply_preset:
  if preset_index < 1:
    preset_index = preset_amount

  if preset_index > preset_amount:
    preset_index = 1

  for preset, index in PRESETS.items():
    if preset_index == index:
      storage.fs.root = storage.fs.preset[preset]
      storage.fs.preset_name = preset
      update_tree = 1
      return run function dpi:tree/render/presets
      advancement grant @s only f"dpi:preset/visited/{preset}"

append function dpi:load:
  preset_amount = list(PRESETS.values())[-1]
  preset_index = 1

  for preset in PRESETS.keys():
    function f"dpi:fs/preset/{preset}"

  function dpi:xmas/init

function dpi:fs/preset/datapack:
  datapack_preset = storage.fs.preset.datapack

  root = Node("root", "dir", datapack_preset)

  pack = Node("pack.mcmeta", "txt", root)
  data = Node("data", "dir", root)
  minecraft = Node("minecraft", "dir", data)
  tags = Node("tags", "dir", minecraft)
  function_tag = Node("function", "dir", tags)
  tick_function_tag = Node("tick.json", "json", function_tag)
  load_function_tag = Node("load.json", "json", function_tag)
  namespace = Node("namespace", "dir", data)
  function = Node("function", "dir", namespace)
  tick = Node("tick.mcfunction", "mcf", function)
  load = Node("load.mcfunction", "mcf", function)
  func = Node("func.mcfunction", "mcf", function)

