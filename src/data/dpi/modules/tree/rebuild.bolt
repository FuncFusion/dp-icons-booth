from dpi:config import storage, var

function dpi:tree/rebuild/init:
  root = storage.fs.root

  stack = storage.rebuild.args
  stack.input = []
  stack.input.append(root)
  stack.new_node = []
  stack.new_children.remove()

  function dpi:tree/rebuild/main
  output = stack.new_children[0]
  rebuild = storage.rebuild.output
  tellraw @a ["rebuild tree:\n", root.children, "\n\n" , rebuild]


function dpi:tree/rebuild/main:
  new_children = stack.new_children[-1]
  new_node = stack.new_node[-1]
  input = stack.input[-1]

  if input.children:
    stack.new_children.append([])
    children = storage.rebuild.children.input
    children = input.children

    execute run function dpi:tree/rebuild/children:
      child = children[0]
      tellraw @a ["  child: ", child.name, " id=", child.id]
      stack.input.append(child)
      stack.new_node.append([])
      function dpi:tree/rebuild/main
      new_children.append(stack.new_node[-1][0])
      stack.new_node[-1].remove()
      
      child.remove()
      if child:
        function dpi:tree/rebuild/children

  entry = storage.temp.entry
  entry.name = input.name
  entry.type = input.type
  entry.id = input.id
  entry.children = new_children
  new_node.append(entry)
  rebuild = input
  input.remove()
