from dpi:config import storage, var

function dpi:tree/rebuild/init:
  root = storage.fs.root
  root_node = root.children[0]
  root_id = root_node.id

  storage.rebuild.entry = []
  storage.rebuild.relations = []
  stack = storage.rebuild.args
  stack = []
  stack.append(root_node.children)

  parent_stack = storage.rebuild.parent_ids
  parent_stack = []
  parent_stack.append(root_id)

  function dpi:tree/rebuild/main
  tellraw @a [">> PASS 2: link"]

  function dpi:tree/rebuild/link_pass

  storage.rebuild.macro.id = root_id
  function dpi:tree/rebuild/get_entry with storage dpi:main rebuild.macro
  tellraw @a ["rebuild tree:\n", storage.rebuild.output]

function dpi:tree/rebuild/main:
  children = stack[-1]
  child = children[0]
  tellraw @a [">> main: ", child.name, " id=", child.id]

  if child:
    entry = storage.temp.entry
    entry.name = child.name
    entry.type = child.type
    entry.id = child.id
    entry.children = []
    storage.rebuild.entry.append(entry)

    tellraw @a ["  child: ", child.name, " id=", child.id]

    parent_id = parent_stack[-1]
    if parent_id != -1:
      storage.rebuild.relations.append([parent_id, child.id])

    if child.children:
      stack.append(child.children)
      parent_stack.append(child.id)

    child.remove()
    function dpi:tree/rebuild/main
    tellraw @a ["  after: ", child.name, " id=", child.id]

  if not child:
    if stack[0]:
      stack[-1].remove()
      parent_stack[-1].remove()
      function dpi:tree/rebuild/main

function dpi:tree/rebuild/link_pass:
  pair = storage.rebuild.relations[0]
  if pair:
    tellraw @a ["  link: p=", pair[0], " c=", pair[1]]
    storage.rebuild.macro.parent_id = pair[0]
    storage.rebuild.macro.child_id = pair[1]
    function dpi:tree/rebuild/append_child with storage dpi:main rebuild.macro
    pair.remove()
    function dpi:tree/rebuild/link_pass

function dpi:tree/rebuild/append_child:
  $data modify storage dpi:main rebuild.entry[{id:$(parent_id)}].children append from storage dpi:main rebuild.entry[{id:$(child_id)}]

function dpi:tree/rebuild/get_entry:
  $data modify storage dpi:main rebuild.output set from storage dpi:main rebuild.entry[{id:$(id)}]
