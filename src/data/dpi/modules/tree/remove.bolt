import bolt_expressions as expr
from dpi:config import storage, var, print_nbt
import dpi:gui as gui

update_tree = var["#dpi.tree.update_pending"]
id = expr.Scoreboard.objective("dpi.node_id", "dummy")

function dpi:node/remove:
  as @n[tag=dpi.node.selected]:
    match = var["#dpi.match"]
    match = id["@s"]
    function dpi:node/remove/init

function dpi:node/remove/init:
  root = storage.fs.root

  stack = storage.rebuild.args
  stack.input = []
  stack.input.append(root)
  stack.new_node = []
  stack.new_children.remove()

  function dpi:node/remove/main
  output = stack.new_children[0]
  tellraw @a ["removed tree:\n", output]
  root.children = []
  root.children = output
  update_tree = 1

function dpi:node/remove/main:
  new_children = stack.new_children[-1]
  new_node = stack.new_node[-1]
  input = stack.input[-1]

  if input.children:
    stack.new_children.append([])
    children = storage.rebuild.children.input
    children = input.children

    execute run function dpi:node/remove/children:
      child = children[0]

      tellraw @a ["trying ", match, " to ", child.id]

      if child.id != match:
        new_children.append(child)
      child.remove()
      
      if child:
        input.append(child)
        function dpi:node/remove/children

  entry = storage.temp.entry
  entry.name = input.name
  entry.type = input.type
  entry.id = input.id
  entry.children = new_children
  new_node.append(entry)

  input.remove()
