import dpi:gui as gui
import dpi:icons as icons
import bolt_expressions as expr

from dpi:config import storage, var, print_nbt, get_icon
from dpi:tree/object import Tree
from dpi:filesystem import Node

stack = storage.rebuild.args

update_tree = var["#dpi.tree.update_pending"]
is_dir = var["#dpi.node.is_dir"]
in_namespace = var["#dpi.tree.in_namespace"]
parent_is_namespace = var["#dpi.tree.parent_is_namespace"]
id = expr.Scoreboard.objective("dpi.node_id", "dummy")
depth = var["#dpi.depth"]
xmas_theme = var["#dpi.xmas_theme"]
render_input = storage.node.render.input
parent = storage.temp.parent
resource_type = storage.temp.resource_type

function dpi:node/summon:
  function dpi:node/render/get_name
  function dpi:node/render/spawn

function dpi:node/render/build_name:
  empty_string = {text:"                                                                 "}
  name = [print_nbt("icon"), {text:" "}, print_nbt("node.render.input.name"), empty_string]
  storage.node.render.output = name
  storage.node.render.output_icon = print_nbt("icon")

function dpi:node/render/get_name:

  icon = storage.icon
  icon.remove()

  execute run function dpi:node/render/get_icon with storage dpi:main node.render.input:
    $data modify storage dpi:main icon set from storage dpi:generated typed_icons."$(type)"
    $execute if data storage dpi:generated named_icons."$(resource_type)" if data storage dpi:main node.render.input{type:"json"} run data modify storage dpi:main icon set from storage dpi:generated named_icons."$(resource_type)"
    $execute if data storage dpi:generated named_icons."$(resource_type)_file" if data storage dpi:main node.render.input{type:"json"} run data modify storage dpi:main icon set from storage dpi:generated named_icons."$(resource_type)_file"
    $execute unless data storage dpi:main node.render.input{type:"dir"} if data storage dpi:generated named_files."$(name)" run data modify storage dpi:main icon set from storage dpi:generated named_files."$(name)"
    $execute if data storage dpi:main node.render.input{type:"dir"} if data storage dpi:generated named_dirs."$(name)" run data modify storage dpi:main icon set from storage dpi:generated named_dirs."$(name)"

  is_dir = 0
  if render_input.type == "dir":
    is_dir = 1

  function dpi:node/render/resolve_icon

  function dpi:node/render/build_name

function dpi:node/render/resolve_icon:
  if render_input.closed:
    if in_namespace and is_dir:
      if xmas_theme:
        icon = get_icon("namespace_folder_closed_xmas")
      else:
        icon = get_icon("namespace_folder_closed")
    else:
      if xmas_theme:
        icon = get_icon("generic_folder_closed_xmas")
      else:
        icon = get_icon("generic_folder_closed")
  elif in_namespace and is_dir:
    if xmas_theme:
      icon = get_icon("namespace_folder_xmas")
      function dpi:xmas/try_named_icon with storage dpi:main node.render.input
    else:
      icon = get_icon("namespace_folder")
  elif not render_input.closed and is_dir:
    if xmas_theme:
      has_named_icon = var["#dpi.has_named_icon"]
      has_named_icon = 0
      execute run function dpi:xmas/has_named_icon with storage dpi:main node.render.input
      function dpi:xmas/try_named_icon with storage dpi:main node.render.input
      if not has_named_icon:
        icon = get_icon("generic_folder_xmas")

  if not icon:
    icon = get_icon("generic_file")

function dpi:node/right_click:
  function dpi:node/toggle/select
  # execute on target run dialog show @s dpi:node/operate

function dpi:node/render/spawn:
  right_click = "function dpi:node/right_click"
  left_click = "function dpi:node/fold"

  button = gui.Button(left_click, right_click, name)
  button.spawn("south", 4, 0.25, ["dpi.node.new", "dpi.tree.node"], [0.5, -0.25, 0.0])

  execute as @n[tag=dpi.node.new, type=interaction]:
    entity = expr.Data.entity("@s")
    on passengers run tag @s add dpi.tree.node
    entity.data.node = render_input
    id["@s"] = render_input.id
    if data storage dpi:main node.render.input{type:"dir"} run tag @s add dpi.node.dir
    if data storage dpi:main node.render.input.closed run tag @s add dpi.node.closed
    tag @s remove dpi.node.new

function dpi:tree/render/init:
  root = storage.tree.render.input

  depth = 0
  in_namespace = 0
  resource_type = "none"

  stack.node = []
  stack.node.append(root)
  stack.loops = []
  stack.in_namespace = []
  stack.path = []

  summon marker ~ ~ ~ {Tags:["dpi.tree.marker", "summit.booth_entity.dpi"]}
  as @n[tag=dpi.tree.marker] at @s run function dpi:tree/render/main
  kill @e[tag=dpi.tree.marker]

function dpi:tree/render/main:
  node = stack.node[-1]

  if stack.path[0]:
    at @s function dpi:tree/render/apply_depth
    render_input = node
    render_input.resource_type = resource_type
    at @s function dpi:node/summon
    at @s function dpi:tree/render/reset_depth
    tp @s ~ ~-0.3 ~

  if node.children:
    if not node.closed:
      stack.loops.append(node.children)
      stack.in_namespace.append(in_namespace)
      depth += 1
      at @s function dpi:tree/render/children
      depth -= 1
      stack.in_namespace[-1].remove()
      stack.loops[-1].remove()

  stack.node[-1].remove()

function dpi:tree/render/children:
  child = stack.loops[-1][0]

  if child:
    parent = stack.node[-1]
    stack.path.append(parent.name)

    entry = storage.temp.current_child
    entry = child
    in_namespace = 0
    if parent.name == "data":
      in_namespace = 1
    if parent.name == "assets":
      in_namespace = 1
    parent_is_namespace = stack.in_namespace[-1]
    if parent_is_namespace:
      resource_type = entry.name
    stack.node.append(child)
    at @s function dpi:tree/render/main

    stack.path[-1].remove()

  stack.loops[-1][0].remove()
  if stack.loops[-1][0]:
    at @s function dpi:tree/render/children

def move_marker(x):
  for i in range(10):
    if depth == i:
      for j in range(i):
        at @s tp @s ~x ~ ~

function dpi:tree/render/apply_depth:
  move_marker(0.3)

function dpi:tree/render/reset_depth:
  move_marker(-0.3)

append function dpi:temp:
  tree = Tree()

  storage.fs.root = storage.fs.preset.datapack
  storage.fs.preset_name = "datapack"

  execute positioned 114.5 86.8 -123.95:
    tree.render()

append function dpi:tick:
  if update_tree:
    execute positioned 114.5 86.8 -123.95:
      tree.update()

append function dpi:load:
  schedule function dpi:temp 2t replace
