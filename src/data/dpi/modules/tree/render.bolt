import dpi:gui as gui
import dpi:icons as icons
import bolt_expressions as expr

from dpi:config import storage, var, print_nbt, get_icon
from dpi:tree/object import Tree
from dpi:filesystem import Node

update_tree = var["#dpi.tree.update_pending"]
id = expr.Scoreboard.objective("dpi.node_id", "dummy")

function dpi:node/summon:
  function dpi:node/render/get_name
  function dpi:node/render/spawn

function dpi:node/render/get_name:
  input = storage.node.render.input

  icon = storage.icon
  icon.remove()

  execute run function dpi:node/render/get_icon with storage dpi:main node.render.input:
    $data modify storage dpi:main icon set from storage dpi:generated typed_icons."$(type)"
    $data modify storage dpi:main icon set from storage dpi:generated named_icons."$(name)"

  if input.closed:
    icon = get_icon("generic_folder_closed")

  if not icon:
    icon = get_icon("generic_file")

  empty_string = {text:"                                                                 "}
  name = [print_nbt("icon"), {text:" "}, print_nbt("node.render.input.name"), empty_string]
  storage.node.render.output = name
  storage.node.render.output_icon = print_nbt("icon")

function dpi:node/right_click:
  function dpi:node/toggle/select
  execute on target run dialog show @s dpi:node/operate

function dpi:node/render/spawn:
  right_click = "function dpi:node/right_click"
  left_click = "function dpi:node/fold"

  button = gui.Button(left_click, right_click, name)
  button.spawn("south", 4, 0.25, ["dpi.node.new", "dpi.tree.node"], [0.5, -0.25, 0.0])

  execute as @n[tag=dpi.node.new, type=interaction]:
    entity = expr.Data.entity("@s")
    on passengers run tag @s add dpi.tree.node
    entity.data.node = input
    id["@s"] = input.id
    if data storage dpi:main node.render.input{type:"dir"} run tag @s add dpi.node.dir
    if data storage dpi:main node.render.input.closed run tag @s add dpi.node.closed
    tag @s remove dpi.node.new

function dpi:tree/render/init:
  root = storage.tree.render.input

  depth = var["#dpi.depth"]
  depth = 1

  stack = storage.args.input
  stack = []
  stack.append(root.children)

  summon marker ~ ~ ~ {Tags:["dpi.tree.marker"]}
  as @n[tag=dpi.tree.marker] at @s run function dpi:tree/render/main
  kill @e[tag=dpi.tree.marker]

  function dpi:tree/render/settings

function dpi:tree/render/settings:
  kill @e[tag=dpi.tree.preset_display]

  preset_display = gui.Button("", "", print_nbt("fs.preset_name"))
  execute positioned 111.5 84.8 -123.95:
    preset_display.spawn("south", 2, 0.25, tags=["dpi.tree.preset_display"])

  cycle_next_lmb = "execute on attacker run function dpi:tree/preset/cycle_next"
  cycle_next_rmb = "execute on target run function dpi:tree/preset/cycle_next"

  cycle_next_button = gui.Button(cycle_next_lmb, cycle_next_rmb, "next ➡")
  execute positioned 112.0 84.5 -123.95:
    cycle_next_button.spawn("south", 1, 0.25, tags=["dpi.tree.preset_display"])

  cycle_back_lmb = "execute on attacker run function dpi:tree/preset/cycle_back"
  cycle_back_rmb = "execute on target run function dpi:tree/preset/cycle_back"

  cycle_back_button = gui.Button(cycle_back_lmb, cycle_back_rmb, "⬅ back")
  execute positioned 111.0 84.5 -123.95:
    cycle_back_button.spawn("south", 1, 0.25, tags=["dpi.tree.preset_display"])

function dpi:tree/render/main:
  children = stack[-1]
  item = children[0]

  if item:
    at @s function dpi:node/render

    if item.children:
      if not item.closed:
        stack.append(item.children)
        depth += 1
        at @s function dpi:tree/render/main
        depth -= 1

    item.remove()
    at @s function dpi:tree/render/main

  if not item:
    if stack[0]:
      stack[-1].remove()

function dpi:node/render:
  at @s function dpi:tree/render/apply_depth
  
  storage.node.render.input = item
  at @s function dpi:node/summon
  render_name = print_nbt("node.render.output")

  at @s function dpi:tree/render/reset_depth
  tp @s ~ ~-0.3 ~

def move_marker(x):
  for i in range(10):
    if depth == i:
      for j in range(i):
        at @s tp @s ~x ~ ~

function dpi:tree/render/apply_depth:
  move_marker(0.3)

function dpi:tree/render/reset_depth:
  move_marker(-0.3)

append function dpi:temp:
  tree = Tree()

  storage.fs.root = storage.fs.preset.datapack
  storage.fs.preset_name = "datapack"

  execute positioned 114.5 86.5 -123.95:
    tree.render()

append function dpi:tick:
  if update_tree:
    execute positioned 114.5 86.5 -123.95:
      tree.update()

append function dpi:load:
  schedule function dpi:temp 2t replace
