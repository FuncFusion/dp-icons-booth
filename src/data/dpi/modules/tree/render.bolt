import dpi:gui as gui
import dpi:icons as icons
import bolt_expressions as expr

from dpi:config import storage, var, print_nbt
from dpi:tree/object import Tree
from dpi:filesystem import Node

update_tree = var["#dpi.tree.update_pending"]

def get_icon(name):
  return {atlas:"items", sprite:"dpi:icons/" + name, shadow_color:0}

function dpi:node/render:
  function dpi:node/render/get_name
  function dpi:node/render/spawn

function dpi:node/render/get_name:
  input = storage.node.render.input

  icon = storage.icon
  icon.remove()

  execute run function dpi:node/render/get_icon with storage dpi:main node.render.input:
    $data modify storage dpi:main icon set from storage dpi:generated typed_icons."$(type)"
    $data modify storage dpi:main icon set from storage dpi:generated named_icons."$(name)"

  if not icon:
    icon = get_icon("generic_file")

  empty_string = {text:"                                                            "}
  name = [print_nbt("icon"), {text:" "}, print_nbt("node.render.input.name"), empty_string]
  storage.node.render.output = name

function dpi:node/render/spawn:
  right_click = "execute on passengers run tag @s add dpi.selected"
  left_click = "function dpi:tree/collapse/init"

  button = gui.Button(left_click, right_click, name)
  button.spawn("south", 4, 0.25, ["dpi.node.new", "dpi.tree.node"])

  execute as @n[tag=dpi.node.new]:
    entity = expr.Data.entity("@s")
    on passengers run tag @s add dpi.tree.node
    entity.data.node = input
    tag @s remove dpi.node.new

function dpi:tree/collapse/init:
  entity = expr.Data.entity("@s")
  node = storage.fs
  match = entity.data.node
  stack = storage.args.input
  stack = []
  stack.append(node.child)
  function dpi:tree/collapse/main

function dpi:tree/node/compare:
  item = stack[-1][0]
  match_found = var["#dpi.match"]
  storage.temp = match
  execute store success score f"#dpi.match" dpi.var
    run data modify storage dpi:main temp set from storage dpi:main args.input[-1][0]

  execute store success score f"#dpi.match" dpi.var
    if score f"#dpi.match" dpi.var matches 0

function dpi:tree/collapse/main:
  item = stack[-1][0]

  if not stack:
    return 0

  if item:
    function dpi:tree/node/compare
    match_found = var["#dpi.match"]
    
    if match_found:
      item.collapsed = true
      update_tree = 1
      tellraw @a ["collapsing ", item]
      stack.remove()

    if item.child:
      stack.append(item.child)
      function dpi:tree/collapse/main

    item.remove()
    function dpi:tree/collapse/main

  if stack[0] and not item:
    stack[-1].remove()


append function dpi:temp:
  tree = Tree()
  pack = Node("pack.mcmeta", "txt", tree.root)
  data = Node("data", "dir", tree.root)
  minecraft = Node("minecraft", "dir", data)
  tags = Node("tags", "dir", minecraft)
  function_tag = Node("function", "dir", tags)
  tick_function_tag = Node("tick.json", "json", function_tag)
  load_function_tag = Node("load.json", "json", function_tag)
  dpi_namespace = Node("dpi", "dir", data)
  functions = Node("function", "dir", dpi_namespace)
  tick = Node("tick.mcfunction", "mcf", functions)
  load = Node("load.mcfunction", "mcf", functions)

  execute positioned 112 84 -123:
    tree.render()

# append function dpi:tick:
#   if update_tree:
#     execute positioned 112 84 -123:
#       tree.update()

append function dpi:load:
  schedule function dpi:temp 2t replace
