import bolt_expressions as expr
from dpi:trigger_actions import Action
from dpi:config import print_nbt, storage, var
import dpi:gui as gui

id = expr.Scoreboard.objective("dpi.node_id", "dummy")

function dpi:node/toggle/select:
  entity = expr.Data.entity("@s")

  if entity @s[tag=dpi.node.selected]:
    return run function dpi:node/unselect

  as @e[tag=dpi.node.selected] function dpi:node/unselect

  function dpi:node/select

function dpi:node/unselect:
  function dpi:node/context_menu/kill
  tag @s remove dpi.node.selected
  execute on target run tag @s remove dpi.pending
  execute on target run item replace entity @s weapon.mainhand from entity @s saddle

  entity = expr.Data.entity("@s")
  node = storage.node.select
  node = entity.data.node

  storage.node.render.input = node
  execute on passengers:
    storage.temp.display_text = entity.text
  storage.temp.display_text.extra[1] = storage.node.render.input.name
  execute on passengers:
    entity.text = storage.temp.display_text

function dpi:node/select:
  function dpi:node/context_menu/spawn
  tag @s add dpi.node.selected

  entity = expr.Data.entity("@s")
  node = storage.node.select
  node = entity.data.node

  storage.node.render.input = node
  execute on passengers:
    storage.temp.display_text = entity.text
  storage.temp.display_text.extra[1] = {text: "", color: "aqua"}
  storage.temp.display_text.extra[1].text = storage.node.render.input.name
  execute on passengers:
    entity.text = storage.temp.display_text

function dpi:node/context_menu/spawn:
  remove_button_action = "function dpi:trigger_callback/remove"

  remove_button = gui.Button(remove_button_action, remove_button_action, [{atlas:"items", sprite:"dpi:icons/misc/antbot/deleted_msg"}])
  execute positioned ~-2.2 ~ ~2:
    remove_button.spawn("south", 0.25, 0.25, tags=["dpi.node.context_menu"])

  rename_button_action = "function dpi:trigger_callback/rename"

  rename_button = gui.Button(rename_button_action, rename_button_action, [{atlas:"items", sprite:"dpi:icons/misc/antbot/edited_msg"}])
  execute positioned ~-2.5 ~ ~2:
    rename_button.spawn("south", 0.25, 0.25, tags=["dpi.node.context_menu"])

  create_file_button_action = "function dpi:trigger_callback/create_file"

  create_file_button = gui.Button(create_file_button_action, create_file_button_action, [{atlas:"items", sprite:"dpi:icons/misc/create_file"}])
  execute positioned ~-3.1 ~ ~2:
    create_file_button.spawn("south", 0.25, 0.25, tags=["dpi.node.context_menu"])

  create_dir_button_action = "function dpi:trigger_callback/create_dir"

  create_dir_button = gui.Button(create_dir_button_action, create_dir_button_action, [{atlas:"items", sprite:"dpi:icons/misc/create_folder"}])
  execute positioned ~-2.8 ~ ~2:
    create_dir_button.spawn("south", 0.25, 0.25, tags=["dpi.node.context_menu"])

function dpi:node/context_menu/kill:
  kill @e[tag=dpi.node.context_menu]

append function dpi:trigger_callback/create_dir:
  create_supplied_type = var["#dpi.create_supplied_type"]
  create_supplied_type = 1
  execute on attacker run function dpi:node/create/book
  execute on target run function dpi:node/create/book

append function dpi:trigger_callback/create_file:
  create_supplied_type = var["#dpi.create_supplied_type"]
  create_supplied_type.reset()
  execute on attacker run function dpi:node/create/book
  execute on target run function dpi:node/create/book

append function dpi:trigger_callback/rename:
  execute on attacker run function dpi:node/rename/book
  execute on target run function dpi:node/rename/book

append function dpi:trigger_callback/remove:
  function dpi:node/remove
  as @e[tag=dpi.node.selected] function dpi:node/unselect

dialog dpi:node/operate {
  "type": "minecraft:multi_action",
  "title": {
    "text": "you spin my head right round right round"
  },
  "inputs": [],
  "pause": false,
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "create dir"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": Action("create_dir").trigger()
      }
    },
    {
      "label": {
        "text": "create file"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": Action("create_file").trigger()
      }
    },
    {
      "label": "rename",
      "action": {
        "type": "minecraft:run_command",
        "command": Action("rename").trigger()
      }
    },
    {
      "label": "remove",
      "action": {
        "type": "minecraft:run_command",
        "command": Action("remove").trigger()
      }
    }
  ]
}
