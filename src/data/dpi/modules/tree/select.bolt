import bolt_expressions as expr
from dpi:trigger_actions import Action
from dpi:config import print_nbt, storage, var
import dpi:gui as gui

function dpi:node/toggle/select:
  if entity @s[tag=dpi.node.selected]:
    return run function dpi:node/unselect

  as @e[tag=dpi.node.selected] function dpi:node/unselect

  function dpi:node/select
  # on target run dialog show @s dpi:node/context_menu

function dpi:node/unselect:
  tag @s remove dpi.node.selected

  entity = expr.Data.entity("@s")
  node = storage.node.select
  node = entity.data.node

  storage.node.render.input = node
  function dpi:node/render/get_name
  render_name = print_nbt("node.render.output")

  execute on passengers:
    entity.text = render_name


function dpi:node/select:
  tag @s add dpi.node.selected

  entity = expr.Data.entity("@s")
  node = storage.node.select
  node = entity.data.node

  storage.node.render.input = node
  function dpi:node/render/get_name

  storage.node.render.output[2].color = "aqua"
  render_name = print_nbt("node.render.output")

  execute on passengers:
    entity.text = render_name

append function dpi:trigger_callback/create:
  function dpi:node/create/book

append function dpi:trigger_callback/rename:
  function dpi:node/rename/book

append function dpi:trigger_callback/remove:
  function dpi:node/remove
  # as @n[tag=dpi.node.selected]:
  #   function dpi:node/remove

dialog dpi:node/operate {
  "type": "minecraft:multi_action",
  "title": {
    "text": "you spin my head right round right round"
  },
  "inputs": [],
  "pause": false,
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "create"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": Action("create").trigger()
      }
    },
    {
      "label": "rename",
      "action": {
        "type": "minecraft:run_command",
        "command": Action("rename").trigger()
      }
    },
    {
      "label": "remove",
      "action": {
        "type": "minecraft:run_command",
        "command": Action("remove").trigger()
      }
    }
  ]
}
